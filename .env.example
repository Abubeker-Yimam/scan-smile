DATABASE_URL="file:./dev.db"

# Password for the admin dashboard at /admin. Change before deploying.
ADMIN_PASSWORD="change-me"

# Public base URL encoded into every guest QR code.
# On a phone, "localhost" resolves to the phone itself — to test a real scan,
# set this to your computer's LAN address, e.g. http://192.168.1.20:3000
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
