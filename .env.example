DATABASE_URL="file:./dev.db"

# Password for the admin dashboard at /admin. Change before deploying.
ADMIN_PASSWORD="change-me"

# Base URL encoded into every guest QR code. Read at runtime — change it and
# restart, no rebuild needed.
# On a phone, "localhost" resolves to the phone itself. To test a real scan use
# your LAN address (http://192.168.1.20:3000) or a tunnel's public HTTPS URL.
APP_BASE_URL="http://localhost:3000"

# Where guest photos and videos are written. Leave unset in development and they
# go to public/uploads, served by Next directly. Set it in production to a path
# on a mounted volume (e.g. /data/uploads) and they are served by /media instead.
# UPLOAD_DIR="/data/uploads"
