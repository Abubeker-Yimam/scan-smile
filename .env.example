# Postgres, in development as well as production. Neon and Supabase both have a
# free tier; `docker run -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:16` also
# works. Neon needs ?sslmode=require on the end.
DATABASE_URL="postgresql://user:password@localhost:5432/scan_and_smile"

# Password for the admin dashboard at /admin. Change before deploying.
ADMIN_PASSWORD="change-me"

# Base URL encoded into every guest QR code. Read at runtime — change it and
# restart, no rebuild needed.
# On a phone, "localhost" resolves to the phone itself. To test a real scan use
# your LAN address (http://192.168.1.20:3000) or a tunnel's public HTTPS URL.
APP_BASE_URL="http://localhost:3000"


# --- Media storage -----------------------------------------------------------
#
# Two ways to store guest photos and videos. Leave everything below unset and
# uploads go to public/uploads on local disk, which is right for development.

# Single-container deployment with a mounted volume: point uploads at the
# volume. They then sit outside public/, so /media serves them instead.
# UPLOAD_DIR="/data/uploads"

# Object storage — the recommended production setup. Setting S3_BUCKET switches
# the app to the S3 driver and every other S3_* variable becomes required.
# These values are for Cloudflare R2; AWS S3, Backblaze B2 and Supabase Storage
# use the same four plus their own endpoint.
# S3_BUCKET="scan-and-smile-media"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Public base URL of the bucket — an R2 custom domain, or the r2.dev subdomain.
# This is what guests' browsers fetch photos from, so it must be world-readable.
# MEDIA_BASE_URL="https://media.example.com"
