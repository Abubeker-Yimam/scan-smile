generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  /// Pooled connection, used while serving. On a pooler running in transaction
  /// mode this must carry ?pgbouncer=true — Prisma's prepared statements do not
  /// survive a connection being handed to someone else between queries.
  url      = env("DATABASE_URL")
  /// Unpooled connection, used only by `prisma migrate`. Migrations take locks
  /// and run statements a transaction pooler will not pass through. On a host
  /// with no pooler, set this to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

/// One booked celebration. The host configures it once; every guest card
/// inherits its look, its fallback message and its fallback video.
model Event {
  id        String   @id @default(cuid())
  title     String
  /// WEDDING | BIRTHDAY | GRADUATION | ENGAGEMENT | TRADITIONAL | ANNIVERSARY | BABY_SHOWER | OTHER
  kind      String   @default("WEDDING")
  hostNames String
  eventDate DateTime?
  venue     String?

  /// Overrides the word printed above every guest's name. Lets a host label an
  /// occasion the built-in list does not cover, without a code change.
  eyebrow   String?
  /// Three comma-separated hex colours overriding the palette `kind` implies —
  /// warp, weft and highlight of the tibeb band. Null means use the built-in
  /// palette for this kind.
  themeThreads String?

  /// Used when a guest has no message of their own.
  defaultMessage  String?
  /// Used when a guest has no video of their own.
  defaultVideoUrl String?
  coverImageUrl   String?

  guests    Guest[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One invited person, one QR code, one page.
model Guest {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Printed under the QR code so a card can be matched back to a guest by eye.
  code    String  @unique
  name    String
  /// Ato, Woizero, Dr., Mr. — printed above the name.
  honorific String?
  tableName String?

  /// Overrides the event defaults when set.
  message  String?
  photoUrl String?
  videoUrl String?

  scanCount      Int       @default(0)
  firstScannedAt DateTime?
  lastScannedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

/// Someone asking about their own celebration, from the public contact page.
///
/// Kept in the database rather than emailed onward. An email needs an account,
/// a key and a verified domain, and fails silently when any of the three lapse;
/// a row is still here on Monday morning, in the same dashboard the host
/// already signs in to.
model Inquiry {
  id String @id @default(cuid())

  name    String
  email   String
  phone   String?
  /// The occasion they are planning — an EventKind value, so the reply can
  /// start from the right palette. OTHER when they did not say.
  kind    String  @default("OTHER")
  message String

  eventDate  DateTime?
  guestCount Int?

  /// The language the contact page was in when they wrote — en | am | om.
  /// Answering an Amharic enquiry in English is a small insult that costs
  /// nothing to avoid, so the inbox shows it beside the message.
  locale String @default("en")

  /// Cleared by the host once the enquiry has been answered. Kept rather than
  /// deleted, so an event can be traced back to the message that started it.
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled, createdAt])
}
